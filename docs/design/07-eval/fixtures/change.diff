diff --git a/auth/src/token.ts b/auth/src/token.ts
index 3f1c2a4..9b7e0d1 100644
--- a/auth/src/token.ts
+++ b/auth/src/token.ts
@@ -12,7 +12,9 @@ export function isExpired(token: Token, now: number = Date.now()): boolean {
-  return token.expiresAt < now;
+  // Treat a token as expired a little early so a request that starts just before
+  // expiry doesn't fail halfway through with a 401.
+  return token.expiresAt - CLOCK_SKEW_MS <= now;
 }
+
+export const CLOCK_SKEW_MS = 30_000;
diff --git a/auth/test/token.test.ts b/auth/test/token.test.ts
index 1a2b3c4..5d6e7f8 100644
--- a/auth/test/token.test.ts
+++ b/auth/test/token.test.ts
@@ -20,3 +20,11 @@ describe('isExpired', () => {
+  it('treats a token within the clock skew as expired', () => {
+    const token = { expiresAt: 100_000 };
+    expect(isExpired(token, 100_000 - CLOCK_SKEW_MS)).toBe(true);
+  });
+
+  it('keeps a token outside the clock skew', () => {
+    expect(isExpired({ expiresAt: 100_000 }, 0)).toBe(false);
+  });
 });
