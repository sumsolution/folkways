{
  "description": "A bad first -m is denied even if a later one looks Angular",
  "steps": [
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "git commit -m \"added orders\" -m \"feat(web-app): add orders\"",
          "description": "Run a command"
        },
        "tool_use_id": "toolu_01"
