{
  "description": "mode: team: reset after cd into the team repo (payload cwd elsewhere) passes",
  "env": {
    "me": {
      "projects_dir": "${TEAM}/.."
    },
    "commits": []
  },
  "steps": [
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${PROJECTS}",
        "permission_mode": "default",
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "cd ${TEAM} && git reset --hard HEAD",
          "description": "Run a command"
        },
        "tool_use_id": "toolu_01"
      },
      "expect": {
        "stdout": null
      }
    }
  ]
}
