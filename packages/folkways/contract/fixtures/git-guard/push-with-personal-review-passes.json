{
  "description": "A review in people/<handle>/work/ counts too; not denied, so push.app's default asks",
  "env": {
    "files": {
      "people/alex/work/EX-1-orders/02-review-${HEAD7}.md": "---\nsha: ${HEAD}\n---\n# Review\n\nVerdict: approve\n"
    }
  },
  "steps": [
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "cd ${WORKTREE} && git push",
          "description": "Run a command"
        },
        "tool_use_id": "toolu_01"
      },
      "expect": {
        "stdout": {
          "hookSpecificOutput": {
            "permissionDecision": "ask"
          }
        }
      }
    }
  ]
}
