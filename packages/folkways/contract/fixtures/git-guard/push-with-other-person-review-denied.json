{
  "description": "A review in another person's people/<handle>/work/ does not count",
  "env": {
    "files": {
      "people/sam/work/EX-1-orders/02-review-${HEAD7}.md": "---\nsha: ${HEAD}\n---\n# Review\n\nVerdict: approve\n"
    }
  },
  "steps": [
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "cd ${WORKTREE} && git push -u origin HEAD",
          "description": "Run a command"
        },
        "tool_use_id": "toolu_01"
      },
      "expect": {
        "stdout": {
          "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": "re:review"
          },
          "permissionDecision": "deny",
          "permissionDecisionReason": "re:review"
        }
      }
    }
  ]
}
