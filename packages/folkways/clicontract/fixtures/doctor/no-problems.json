{
  "description": "doctor in a fresh repo, with folkways on PATH, finds no problems",
  "steps": [
    {
      "args": ["init", "${TEAM}"],
      "expect": {
        "files": { "package.json": null, "node_modules": null, "pnpm-workspace.yaml": null }
      }
    },
    {
      "args": ["doctor"],
      "expect": { "stdout": "No problems found.\n", "stderr": "", "unchanged": true }
    }
  ]
}
