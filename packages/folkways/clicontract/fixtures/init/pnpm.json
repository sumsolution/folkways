{
  "description": "init --package-manager pnpm pins the pnpm version, hoists the hook binary and installs with pnpm",
  "steps": [
    {
      "args": ["init", "${TEAM}", "--package-manager", "pnpm"],
      "expect": {
        "stderr": "",
        "files": {
          "${CALLS}": "${ROOT}: pnpm --version\n${TEAM}: pnpm install\n",
          "package.json": "re:\"packageManager\": \"pnpm@9\\.0\\.0\"",
          "pnpm-workspace.yaml": "publicHoistPattern:\n  - \"@folkways/hooks-*\"\n",
          "pnpm-lock.yaml": true,
          "node_modules/.bin/folkways-hook": true
        },
        "git": [{ "args": ["status", "--porcelain"], "stdout": "" }]
      }
    }
  ]
}
