{
  "description": "init writes the scaffold, syncs (the manifest pins the version) and makes one commit, with no Node files. From init.test.ts: init > scaffolds, pins, syncs and commits",
  "steps": [
    {
      "args": [
        "init",
        "${TEAM}"
      ],
      "expect": {
        "stderr": "",
        "files": {
          "folkways.yaml": true,
          ".gitignore": "re:(?m)^node_modules/$",
          "CLAUDE.md": "re:(?m)^@AGENTS\\.md$",
          "knowledge/README.md": true,
          ".folkways/instructions.md": true,
          "AGENTS.md": "re:(?m)^@\\.folkways/instructions\\.md$",
          "package.json": null,
          "pnpm-workspace.yaml": null,
          ".folkways/manifest.json": "re:^\\{\n  \"version\": \"${VERSION}\",",
          ".claude/settings.json": "re:\"Bash\\(git push:\\*\\)\""
        },
        "git": [
          {
            "args": [
              "log",
              "--format=%s"
            ],
            "stdout": "chore(folkways): init at ${VERSION}"
          },
          {
            "args": [
              "rev-list",
              "--count",
              "HEAD"
            ],
            "stdout": "1"
          },
          {
            "args": [
              "branch",
              "--show-current"
            ],
            "stdout": "main"
          },
          {
            "args": [
              "status",
              "--porcelain"
            ],
            "stdout": ""
          }
        ],
        "stdout": "Created ${TEAM} with folkways ${VERSION}.\nNext: open Claude Code or Copilot CLI in ${TEAM} and run the setup skill.\n"
      }
    }
  ]
}
