{
  "description": "upgrade to the version already pinned stops before touching anything: no branch, no commit. TS: it 'is a no-op at the same version'",
  "steps": [
    {
      "args": [
        "init",
        "${TEAM}"
      ]
    },
    {
      "args": [
        "upgrade",
        "${VERSION}"
      ],
      "expect": {
        "stdout": "Already at ${VERSION}; nothing to change.\n",
        "stderr": "",
        "unchanged": true,
        "git": [
          {
            "args": [
              "branch",
              "--show-current"
            ],
            "stdout": "main"
          },
          {
            "args": [
              "branch",
              "--list",
              "chore/*"
            ],
            "stdout": ""
          },
          {
            "args": [
              "status",
              "--porcelain"
            ],
            "stdout": ""
          },
          {
            "args": [
              "log",
              "--format=%s"
            ],
            "stdout": "chore(folkways): init at ${VERSION}"
          }
        ]
      }
    }
  ]
}
