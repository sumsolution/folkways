{
  "description": "upgrade syncs the running version on chore/folkways-<version> (leading v dropped) and commits. TS: it 'runs the new version's sync on a branch and commits'. The manifest version is set to 0.0.1 first, so the message and commit body name the old version",
  "steps": [
    {
      "args": [
        "init",
        "${TEAM}"
      ]
    },
    {
      "git": [
        [
          "-c",
          "alias.edit=!sed -e 's/\"version\": \"${VERSION}\"/\"version\": \"0.0.1\"/' .folkways/manifest.json > .folkways/m.tmp && mv .folkways/m.tmp .folkways/manifest.json",
          "edit"
        ],
        [
          "add",
          "-A"
        ],
        [
          "commit",
          "-qm",
          "pin 0.0.1"
        ]
      ]
    },
    {
      "args": [
        "upgrade",
        "v${VERSION}"
      ],
      "expect": {
        "stdout": "Committed 0.0.1 -> ${VERSION} on chore/folkways-${VERSION}. Review, push, open a PR.\n",
        "stderr": "",
        "files": {
          ".folkways/manifest.json": "re:^\\{\n  \"version\": \"${VERSION}\",\n  \"skills\": \\[\n",
          ".claude/skills/start/SKILL.md": true
        },
        "git": [
          {
            "args": [
              "branch",
              "--show-current"
            ],
            "stdout": "chore/folkways-${VERSION}"
          },
          {
            "args": [
              "log",
              "-1",
              "--format=%s"
            ],
            "stdout": "chore(folkways): upgrade to ${VERSION}"
          },
          {
            "args": [
              "log",
              "-1",
              "--format=%b"
            ],
            "stdout": "From 0.0.1."
          },
          {
            "args": [
              "status",
              "--porcelain"
            ],
            "stdout": ""
          },
          {
            "args": [
              "rev-list",
              "--count",
              "main..HEAD"
            ],
            "stdout": "1"
          }
        ]
      }
    }
  ]
}
