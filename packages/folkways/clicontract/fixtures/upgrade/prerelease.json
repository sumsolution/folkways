{
  "description": "upgrade accepts a prerelease version as valid, then refuses because the running binary isn't that version: upgrade syncs the binary's own content (ADR 0012). Nothing changes",
  "steps": [
    {
      "args": [
        "init",
        "${TEAM}"
      ]
    },
    {
      "args": [
        "upgrade",
        "1.0.0-beta.1"
      ],
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "folkways: this is folkways ${VERSION}; install folkways 1.0.0-beta.1, then rerun 'folkways upgrade 1.0.0-beta.1'\n",
        "unchanged": true,
        "git": [
          {
            "args": [
              "branch",
              "--show-current"
            ],
            "stdout": "main"
          },
          {
            "args": [
              "branch",
              "--list",
              "chore/*"
            ],
            "stdout": ""
          },
          {
            "args": [
              "status",
              "--porcelain"
            ],
            "stdout": ""
          }
        ]
      }
    }
  ]
}
