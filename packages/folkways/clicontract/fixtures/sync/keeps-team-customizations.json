{
  "description": "sync.test.ts 'sync to a new version' > 'keeps team customizations'",
  "steps": [
    {
      "args": [
        "init",
        "${TEAM}"
      ]
    },
    {
      "files": {
        "AGENTS.md": "# Example Team\n\n@.folkways/instructions.md\n\nTeam footer.\n",
        "overlays/start/OVERLAY.md": "team overlay\n",
        ".claude/skills/team-skill/SKILL.md": "team skill\n",
        ".claude/settings.json": "{\"permissions\": {\"allow\": [\"Bash(ls:*)\"]}, \"hooks\": {\"Stop\": [{\"hooks\": [{\"type\": \"command\", \"command\": \"scripts/team.sh\"}]}]}}"
      },
      "git": [
        [
          "add",
          "-A"
        ],
        [
          "commit",
          "-qm",
          "team change"
        ]
      ]
    },
    {
      "args": [
        "sync"
      ],
      "expect": {
        "stdout": "Synced folkways ${VERSION}. Review with git status, then commit.\n",
        "stderr": "",
        "files": {
          "AGENTS.md": "# Example Team\n\n@.folkways/instructions.md\n\nTeam footer.\n",
          "overlays/start/OVERLAY.md": "team overlay\n",
          ".claude/skills/team-skill/SKILL.md": "team skill\n",
          ".claude/settings.json": "re:(?s)\"permissions\": \\{\\s*\"allow\": \\[\\s*\"Bash\\(ls:\\*\\)\"\\s*\\]\\s*\\}"
        }
      }
    }
  ]
}
