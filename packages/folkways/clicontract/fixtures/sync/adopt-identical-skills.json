{
  "description": "sync.test.ts 'sync without a manifest, with framework skills in place' > 'adopts identical skills'",
  "steps": [
    {
      "args": [
        "init",
        "${TEAM}"
      ]
    },
    {
      "files": {
        ".folkways/manifest.json": null
      },
      "git": [
        [
          "add",
          "-A"
        ],
        [
          "commit",
          "-qm",
          "team change"
        ]
      ]
    },
    {
      "args": [
        "sync"
      ],
      "expect": {
        "stdout": "Synced folkways ${VERSION}. Review with git status, then commit.\n",
        "stderr": "",
        "files": {
          ".folkways/manifest.json": "re:(?s)\"skills\": \\[\\s*\"adr\",.*\"start\","
        }
      }
    }
  ]
}
