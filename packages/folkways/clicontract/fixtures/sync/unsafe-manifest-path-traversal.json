{
  "description": "sync.test.ts 'sync refusals and warnings' > 'rejects an unsafe manifest before forced deletion' (unsafe path \"../../outside\"); --force still refuses and touches nothing outside the repo",
  "steps": [
    {
      "args": [
        "init",
        "${TEAM}"
      ]
    },
    {
      "files": {
        ".folkways/manifest.json": "{\"version\": \"0.1.0\", \"skills\": [], \"files\": {\"../../outside\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}}\n",
        "${ROOT}/outside": "keep\n"
      },
      "git": [
        [
          "add",
          "-A"
        ],
        [
          "commit",
          "-qm",
          "team change"
        ]
      ]
    },
    {
      "args": [
        "sync",
        "--force"
      ],
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "folkways: .folkways/manifest.json: unsafe path \"../../outside\". Restore it with 'git checkout -- .folkways/manifest.json'.\n",
        "unchanged": true,
        "files": {
          "${ROOT}/outside": "keep\n",
          "folkways.yaml": true
        }
      }
    }
  ]
}
