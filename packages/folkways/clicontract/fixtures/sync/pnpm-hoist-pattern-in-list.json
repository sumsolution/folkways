{
  "description": "sync.test.ts 'sync refusals and warnings' > 'pnpm team with %s', case \"the pattern in a list\": no warning",
  "steps": [
    {
      "args": [
        "init",
        "${TEAM}",
        "--no-install"
      ]
    },
    {
      "args": [
        "sync"
      ],
      "files": {
        "package.json": "{\"name\": \"team\", \"private\": true, \"devDependencies\": {\"@folkways/cli\": \"0.1.0\"}, \"packageManager\": \"pnpm@10.0.0\"}",
        "pnpm-workspace.yaml": "packages: []\npublicHoistPattern:\n  - \"*eslint*\"\n  - '@folkways/hooks-*'\n"
      },
      "expect": {
        "stdout": "Synced folkways ${VERSION}. Review with git status, then commit.\n",
        "stderr": ""
      }
    }
  ]
}
