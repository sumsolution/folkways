{
  "description": "overlays.test.ts 'parseOverlay' > 'refuses the same override ID twice'",
  "steps": [
    {
      "args": [
        "init",
        "${TEAM}"
      ]
    },
    {
      "args": [
        "sync"
      ],
      "files": {
        "overlays/commit/OVERLAY.md": "## Override {#types}\n\na\n\n## Override {#types}\n\nb\n"
      },
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "folkways: overlays/commit/OVERLAY.md: overlay overrides #types twice\n",
        "unchanged": true
      }
    }
  ]
}
