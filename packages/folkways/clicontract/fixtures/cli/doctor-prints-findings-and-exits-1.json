{
  "description": "TS cli.test.ts: it('doctor prints each finding and exits 1 on errors')",
  "steps": [
    {
      "args": [
        "init",
        "${TEAM}",
        "--no-install"
      ]
    },
    {
      "args": [
        "doctor"
      ],
      "expect": {
        "exit": 1,
        "stdout": "re:^error: @folkways/cli is not installed; run 'p?npm install'\n1 error, 0 warnings\\.\n$"
      }
    },
    {
      "files": {
        "node_modules/@folkways/cli/package.json": "{\"version\": \"${VERSION}\"}",
        "node_modules/.bin/folkways-hook": ""
      },
      "args": [
        "doctor"
      ],
      "expect": {
        "stdout": "No problems found.\n",
        "stderr": ""
      }
    }
  ]
}
