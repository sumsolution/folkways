{
  "disableAllHooks": false,
  "permissions": {
    "ask": ["Bash(git push:*)"]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/node_modules/.bin/folkways-hook session-start" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/node_modules/.bin/folkways-hook context-band" }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/node_modules/.bin/folkways-hook git-guard" }]
      }
    ],
    "PostToolBatch": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/node_modules/.bin/folkways-hook context-band" }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/node_modules/.bin/folkways-hook precompact" }] }
    ]
  }
}
