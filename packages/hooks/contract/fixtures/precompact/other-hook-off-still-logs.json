{
  "description": "Turning another hook off leaves precompact on",
  "env": {
    "team": {
      "hooks": {
        "git-guard": false
      }
    }
  },
  "steps": [
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "PreCompact",
        "trigger": "auto"
      },
      "expect": {
        "stdout": null,
        "exists": [
          "${TEAM}/.local/precompact.log"
        ]
      }
    }
  ]
}
