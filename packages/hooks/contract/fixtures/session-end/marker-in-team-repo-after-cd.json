{
  "description": "The marker goes to the team repo even when the hook cwd drifted",
  "steps": [
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${WORKTREE}",
        "permission_mode": "default",
        "hook_event_name": "SessionEnd",
        "reason": "other"
      },
      "cwd": "${WORKTREE}",
      "expect": {
        "stdout": null,
        "exists": [
          "${TEAM}/.local/sessions/11111111-1111-4111-8111-111111111111.unclosed"
        ],
        "absent": [
          "${WORKTREE}/.local"
        ]
      }
    }
  ]
}
