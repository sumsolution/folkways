{
  "description": "commit_convention: pattern denies a subject that does not match, naming the pattern",
  "env": {
    "team": {
      "git": {
        "commit_convention": "pattern",
        "commit_pattern": "^[A-Z]+-\\d+: .+"
      }
    }
  },
  "steps": [
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "git commit -m \"feat(auth): add orders\"",
          "description": "Run a command"
        },
        "tool_use_id": "toolu_01"
      },
      "expect": {
        "stdout": {
          "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": "re:doesn't match folkways\\.yaml git\\.commit_pattern.*\\[A-Z\\]"
          },
          "permissionDecision": "deny",
          "permissionDecisionReason": "re:doesn't match folkways\\.yaml git\\.commit_pattern.*\\[A-Z\\]"
        }
      }
    }
  ]
}
