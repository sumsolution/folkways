{
  "description": "mode: solo: the review rides in a commit that also changes code, so the walk stops there and the reviewed parent is not reached",
  "env": {
    "team": {
      "mode": "solo"
    },
    "me": {
      "handle": null
    },
    "commits": [
      {
        "files": {
          "src/app.md": "code\n"
        },
        "message": "feat: add app"
      },
      {
        "files": {
          "inbox/2026-09-29-review-${COMMIT_1_7}.md": "review\n",
          "src/more.md": "more\n"
        },
        "message": "feat: more"
      }
    ]
  },
  "steps": [
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "git push -u origin HEAD",
          "description": "Run a command"
        },
        "tool_use_id": "toolu_01"
      },
      "expect": {
        "stdout": {
          "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": "re:no review of HEAD"
          },
          "permissionDecision": "deny",
          "permissionDecisionReason": "re:no review of HEAD"
        }
      }
    }
  ]
}
