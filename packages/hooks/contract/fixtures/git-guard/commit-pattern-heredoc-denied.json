{
  "description": "The pattern is checked against the first line of a heredoc message",
  "env": {
    "team": {
      "git": {
        "commit_convention": "pattern",
        "commit_pattern": "^[A-Z]+-\\d+: .+"
      }
    }
  },
  "steps": [
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "git commit -m \"$(cat <<'EOF'\nadd orders\n\nEX-12: in the body only\nEOF\n)\"",
          "description": "Run a command"
        },
        "tool_use_id": "toolu_01"
      },
      "expect": {
        "stdout": {
          "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": "re:commit_pattern"
          },
          "permissionDecision": "deny",
          "permissionDecisionReason": "re:commit_pattern"
        }
      }
    }
  ]
}
