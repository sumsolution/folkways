{
  "description": "mode: team: no walk-back; a review of the previous commit does not cover HEAD",
  "env": {
    "commits": [
      {
        "files": {
          "src/app.md": "code\n"
        },
        "message": "feat: add app"
      },
      {
        "files": {
          "people/alex/inbox/2026-09-29-review-${COMMIT_1_7}.md": "review\n"
        },
        "message": "docs: review"
      }
    ]
  },
  "steps": [
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "git push -u origin HEAD",
          "description": "Run a command"
        },
        "tool_use_id": "toolu_01"
      },
      "expect": {
        "stdout": {
          "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": "re:no review of HEAD"
          },
          "permissionDecision": "deny",
          "permissionDecisionReason": "re:no review of HEAD"
        }
      }
    }
  ]
}
