{
  "description": "Both messages when both apply",
  "env": {
    "files": {
      ".local/sessions/22222222-2222-4222-8222-222222222222.unclosed": ""
    }
  },
  "steps": [
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "SessionStart",
        "source": "compact"
      },
      "expect": {
        "stdout": {
          "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": "re:(00-STATUS\\.md.*session-close|session-close.*00-STATUS\\.md)"
          }
        }
      }
    }
  ]
}
