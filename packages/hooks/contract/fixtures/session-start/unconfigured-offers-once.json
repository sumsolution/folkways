{
  "description": "No folkways.yaml: the first session offers setup and records the repo, the second says nothing",
  "env": {
    "team": null
  },
  "steps": [
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "SessionStart",
        "source": "startup"
      },
      "expect": {
        "stdout": {
          "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": "re:isn't set up.*setup.*won't be shown again"
          }
        },
        "contains": {
          "${XDG}/folkways/offered": "^${TEAM}\\n$"
        },
        "absent": [
          "${TEAM}/folkways.yaml",
          "${TEAM}/.local/hooks"
        ]
      }
    },
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "SessionStart",
        "source": "startup"
      },
      "expect": {
        "stdout": null,
        "contains": {
          "${XDG}/folkways/offered": "^${TEAM}\\n$"
        }
      }
    }
  ]
}
