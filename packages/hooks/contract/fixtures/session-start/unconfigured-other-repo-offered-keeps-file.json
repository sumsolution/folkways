{
  "description": "Another repo in the offered file does not suppress the offer; the new path is appended",
  "env": {
    "team": null,
    "offered": [
      "/elsewhere"
    ]
  },
  "steps": [
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "SessionStart",
        "source": "startup"
      },
      "expect": {
        "stdout": {
          "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": "re:isn't set up.*setup.*won't be shown again"
          }
        },
        "contains": {
          "${XDG}/folkways/offered": "^/elsewhere\\n${TEAM}\\n$"
        }
      }
    }
  ]
}
