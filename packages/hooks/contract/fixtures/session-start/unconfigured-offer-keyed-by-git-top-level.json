{
  "description": "Project dir is a subfolder of a git repo without folkways.yaml: the offer is recorded under the git top level",
  "env": {
    "team": null,
    "claudeProjectDir": "${TEAM}/sub",
    "files": {
      "sub/readme.md": "x\n"
    },
    "commits": []
  },
  "steps": [
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}/sub",
        "permission_mode": "default",
        "hook_event_name": "SessionStart",
        "source": "startup"
      },
      "expect": {
        "stdout": {
          "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": "re:isn't set up"
          }
        },
        "contains": {
          "${XDG}/folkways/offered": "^${TEAM}\\n$"
        }
      }
    }
  ]
}
