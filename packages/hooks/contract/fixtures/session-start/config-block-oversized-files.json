{
  "description": "A file over 4096 bytes is not printed, a one-line pointer instead",
  "env": {
    "files": {
      "folkways.yaml": "team:\n  name: Example Team\n# \n"
    },
    "me": {
      "note": ""
    }
  },
  "steps": [
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "SessionStart",
        "source": "startup"
      },
      "expect": {
        "stdout": {
          "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": "re:\\n\\nfolkways\\.yaml: over 4096 bytes, not shown\\. Read the file\\.\\n\\n\\.local/me\\.yaml: over 4096 bytes, not shown\\. Read the file\\.$"
          }
        }
      }
    }
  ]
}
