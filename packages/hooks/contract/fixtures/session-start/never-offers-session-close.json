{
  "description": "session-start never offers session-close",
  "steps": [
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "SessionStart",
        "source": "startup"
      },
      "expect": {
        "stdout": {
          "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": "re:^(?!.*session-close).*start"
          }
        }
      }
    }
  ]
}
