{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.6.0/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "go",
      "package-name": "folkways",
      "changelog-path": "packages/folkways/CHANGELOG.md",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "draft": true,
      "force-tag-creation": true,
      "pull-request-title-pattern": "build: release folkways ${version}",
      "exclude-paths": ["packages/evals"]
    }
  }
}
