{
  "description": "Each compaction appends a line",
  "steps": [
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "PreCompact",
        "trigger": "auto"
      },
      "expect": {
        "stdout": null
      }
    },
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "PreCompact",
        "trigger": "manual"
      },
      "expect": {
        "stdout": null,
        "contains": {
          "${TEAM}/.local/precompact.log": "11111111-1111-4111-8111-111111111111.*auto.*\\n.*11111111-1111-4111-8111-111111111111.*manual"
        }
      }
    }
  ]
}
