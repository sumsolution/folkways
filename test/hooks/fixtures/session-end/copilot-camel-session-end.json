{
  "description": "camelCase sessionEnd payload (sessionId) writes the marker",
  "env": {
    "claudeProjectDir": false
  },
  "steps": [
    {
      "payload": {
        "sessionId": "11111111-1111-4111-8111-111111111111",
        "timestamp": 1790000000000,
        "cwd": "${TEAM}",
        "reason": "user_exit"
      },
      "expect": {
        "stdout": null,
        "exists": [
          "${TEAM}/.local/sessions/11111111-1111-4111-8111-111111111111.unclosed"
        ]
      }
    }
  ]
}
