{
  "description": "An unclosed-session marker: offer session-close",
  "env": {
    "files": {
      ".local/sessions/22222222-2222-4222-8222-222222222222.unclosed": ""
    }
  },
  "steps": [
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "SessionStart",
        "source": "startup"
      },
      "expect": {
        "stdout": {
          "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": "re:session-close"
          }
        }
      }
    }
  ]
}
