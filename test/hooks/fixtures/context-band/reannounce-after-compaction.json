{
  "description": "After context drops below a band, crossing it again re-announces",
  "steps": [
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "UserPromptSubmit",
        "prompt": "next step"
      },
      "transcript": [
        130000
      ],
      "expect": {
        "stdout": {
          "hookSpecificOutput": {
            "hookEventName": "UserPromptSubmit",
            "additionalContext": "re:125K"
          }
        }
      }
    },
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "UserPromptSubmit",
        "prompt": "next step"
      },
      "transcript": [
        130000,
        30000
      ],
      "expect": {
        "stdout": null
      }
    },
    {
      "payload": {
        "session_id": "11111111-1111-4111-8111-111111111111",
        "transcript_path": "${TRANSCRIPT}",
        "cwd": "${TEAM}",
        "permission_mode": "default",
        "hook_event_name": "UserPromptSubmit",
        "prompt": "next step"
      },
      "transcript": [
        130000,
        30000,
        131000
      ],
      "expect": {
        "stdout": {
          "hookSpecificOutput": {
            "hookEventName": "UserPromptSubmit",
            "additionalContext": "re:125K"
          }
        }
      }
    }
  ]
}
